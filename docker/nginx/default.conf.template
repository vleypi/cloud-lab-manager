resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 4m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    server_tokens off;

    # CSP frame-ancestors из env LTI_EMBED_FRAME_ANCESTORS подставится envsubst
    # X-Frame-Options НЕ ставим он перебивает современный CSP
    add_header Content-Security-Policy "frame-ancestors 'self' ${LTI_EMBED_FRAME_ANCESTORS_EXTRA}" always;

    location ~ ^/api/v1/stands/[^/]+/console$ {
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream;
    }

    location /console-proxy/ {
        proxy_pass https://${NOVNC_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host ${NOVNC_UPSTREAM};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_redirect off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /websockify {
        proxy_pass https://${NOVNC_UPSTREAM}/websockify;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${NOVNC_UPSTREAM};
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location /docs {
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream/docs;
    }
    location /redoc {
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream/redoc;
    }
    location = /openapi.json {
        set $api_upstream "api:8000";
        proxy_pass http://$api_upstream/openapi.json;
    }

    # Next.js статика и страницы.
    location /_next/ {
        set $web_upstream "web:3000";
        proxy_pass http://$web_upstream;
    }
    location / {
        set $web_upstream "web:3000";
        proxy_pass http://$web_upstream;
    }
}
